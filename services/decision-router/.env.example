ENVIRONMENT=development
HOST=0.0.0.0
PORT=8002
DEBUG=true
LOG_LEVEL=INFO

# Backend Task Service
TASK_SERVICE_URL=http://localhost:8001

# Local LLM / Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
SLM_MODEL=qwen2.5:1.5b

# Online Cloud LLM (Instant <400ms inference; eliminates laptop lag)
# Option 1: Google Gemini (Free tier available: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Groq Cloud (Ultra-fast Llama-3.3 70B: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI (GPT-4o mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
